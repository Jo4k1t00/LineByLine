  codigo: {fileID: 4900000, guid: 6c608b3d4f5611c4b9ad5eeda0885cf9, type: 3}
  pasos:
  - linea: 0
    fragmento: void Disparar()
    texto: "Una funci\xF3n es un grupo de \xF3rdenes con nombre. Esta se llama Disparar."
  - linea: 2
    fragmento: var bala
    texto: "Aqu\xED se crea una variable, una caja con etiqueta donde guardamos la
      bala."
  - linea: 2
    fragmento: Instantiate
    texto: Instantiate copia un prefab, que es como un molde para hacer balas.
  - linea: 2
    fragmento: punta.position
    texto: "Esto dice d\xF3nde aparece la bala: justo en la boca del ca\xF1\xF3n."
  - linea: 3
    fragmento: AddForce
    texto: "Le da un empuj\xF3n a la bala para que salga disparada."
  prefab: {fileID: 7518864093674716581, guid: e3f9941c417ce6840a7d329083a7f5dc, type: 3}
  punta: {fileID: 801008833}
